{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Archive familiale",
  "version": "../package.json",
  "identifier": "fr.archivefamiliale.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Archive familiale",
        "width": 1320,
        "height": 880,
        "minWidth": 860,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Arbre généalogique et souvenirs de famille",
    "longDescription": "Archive familiale : saisir l'arbre généalogique, les photos, les lieux et les histoires de la famille, puis publier un site privé pour la famille.",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2MUQ4NkZGMjFCRUFDMUEKUldRYXJMNGgvNFlkeHFHMzIwVWlkcnRwTmk2UnJRNjk0Z2Y3aDlhZFVRTHhEaVNBczd6K3YwUmcK",
      "endpoints": [
        "https://github.com/PROPRIETAIRE/DEPOT/releases/latest/download/latest.json"
      ]
    }
  }
}
