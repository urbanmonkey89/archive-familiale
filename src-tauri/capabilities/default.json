{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Accès aux fichiers de l'archive choisie par l'utilisateur, boîtes de dialogue et mises à jour.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
